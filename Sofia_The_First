-- Useful views for reporting
CREATE VIEW StudentDetails AS
SELECT 
    s.student_id,
    s.reg_no,
    p.first_name,
    p.last_name,
    p.email,
    p.phone,
    pr.name as program_name,
    s.year_of_study,
    s.status as student_status
FROM Student s
JOIN Person p ON s.person_id = p.person_id
JOIN Program pr ON s.program_id = pr.prog_id;

CREATE VIEW EnrollmentDetails AS
SELECT 
    e.enrollment_id,
    s.reg_no,
    p.first_name,
    p.last_name,
    c.code as course_code,
    c.title as course_title,
    cs.semester,
    cs.year,
    cs.room,
    e.status as enrollment_status,
    e.final_grade
FROM Enrollment e
JOIN Student s ON e.student_id = s.student_id
JOIN Person p ON s.person_id = p.person_id
JOIN CourseSection cs ON e.section_id = cs.section_id
JOIN Course c ON cs.course_id = c.course_id;

CREATE VIEW GradeDetails AS
SELECT 
    g.grade_id,
    s.reg_no,
    p.first_name,
    p.last_name,
    c.code as course_code,
    c.title as course_title,
    a.name as assessment_name,
    a.weight,
    g.score,
    CONCAT(lp.first_name, ' ', lp.last_name) as graded_by_name,
    g.graded_at
FROM Grade g
JOIN Enrollment e ON g.enrollment_id = e.enrollment_id
JOIN Student s ON e.student_id = s.student_id
JOIN Person p ON s.person_id = p.person_id
JOIN CourseSection cs ON e.section_id = cs.section_id
JOIN Course c ON cs.course_id = c.course_id
JOIN Assessment a ON g.assessment_id = a.assessment_id
LEFT JOIN Lecturer l ON g.graded_by = l.lecturer_id
LEFT JOIN Person lp ON l.person_id = lp.person_id;